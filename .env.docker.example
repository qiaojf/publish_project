# Copy this file to the project-root .env before running Docker Compose.
# POSTGRES_PASSWORD is inserted into the SQLAlchemy URL, so use URL-safe characters.
POSTGRES_DB=content_publish
POSTGRES_USER=content_publish
POSTGRES_PASSWORD=replace_with_a_strong_url_safe_password
JWT_SECRET_KEY=replace_with_at_least_32_random_characters

APP_PORT=8080
TZ=Asia/Tokyo
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
