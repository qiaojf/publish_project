# Backend gateway on the host whose address ends in .143.
#
# Replace <FRONTEND_IP> and <PUBLISHED_ROOT> before running `nginx -t`.
# FastAPI is intentionally bound to loopback; only this gateway exposes it.

server {
    listen 18080;
    listen [::]:18080;
    server_name _;

    allow <FRONTEND_IP>;
    allow 127.0.0.1;
    deny all;

    client_max_body_size 1100m;
    client_body_timeout 900s;
    send_timeout 900s;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:18000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $http_x_real_ip;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Request-ID $http_x_request_id;

        proxy_connect_timeout 30s;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_next_upstream off;
    }

    location ^~ /local-published/ {
        alias <PUBLISHED_ROOT>/;
        index index.html;
        autoindex off;
        disable_symlinks on;
        limit_except GET HEAD { deny all; }
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        return 404;
    }
}
