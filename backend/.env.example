APP_NAME=Internal Content Publish Platform
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/content_publish
TEST_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/content_publish_test

JWT_SECRET_KEY=change-this-in-production-use-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

SOURCE_STORAGE_ROOT=../local-data/source
PREVIEW_STORAGE_ROOT=../local-data/preview
BUILD_STORAGE_ROOT=../local-data/build
LOCAL_PUBLISHED_ROOT=../local-data/published
LOCAL_PUBLISHED_BASE_URL=http://localhost:8000/local-published
MAX_UPLOAD_SIZE_MB=100

PUBLISH_CONNECTION_TIMEOUT_SECONDS=30
PUBLISH_OPERATION_TIMEOUT_SECONDS=300

# Secrets use PUBLISH_CREDENTIAL_{CREDENTIAL_REF}_{KEY}; process environment takes precedence,
# then this backend/.env file is used. Never put secrets in target config.
# PUBLISH_CREDENTIAL_GITHUB_COMPANY_PAGES_TOKEN=
# PUBLISH_CREDENTIAL_ONEDRIVE_COMPANY_CLIENT_SECRET=
# PUBLISH_CREDENTIAL_DROPBOX_COMPANY_TOKEN=
# PUBLISH_CREDENTIAL_SFTP_INTERNAL_PASSWORD=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Used only when scripts/seed.py creates the initial accounts. Override in production.
SEED_ADMIN_PASSWORD=admin123
SEED_EMPLOYEE_PASSWORD=employee123
